# Environment Variables — Hotel AI Concierge
# Copy this to .env and fill in your values

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Options: mock | gemini | bedrock
LLM_PROVIDER=mock

# Google Gemini (when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Amazon Bedrock (when LLM_PROVIDER=bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# ─── Database ─────────────────────────────────────────────────────────────────
# Leave empty to use SQLite (./hotel_concierge.db) for local dev
# Set to postgres URL for production
DATABASE_URL=
# DATABASE_URL=postgresql://hotel_user:hotel_pass@localhost:5432/hotel_concierge

# ─── Vector Database ─────────────────────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=hotel_faqs

# ─── Embeddings ───────────────────────────────────────────────────────────────
# HuggingFace model — runs locally, no API key needed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── RAG Settings ─────────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3

# ─── Redis (optional — for session persistence) ───────────────────────────────
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# ─── LangSmith Observability & Tracing ────────────────────────────────────────
# Enable LangSmith tracing for LangChain, LangGraph agent, and RAG pipelines
# Get your API key at: https://smith.langchain.com/settings
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=hotel-ai-concierge
# Also accepts LANGSMITH_API_KEY, LANGSMITH_PROJECT, LANGSMITH_TRACING

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30

# ─── PostgreSQL (Docker Compose) ──────────────────────────────────────────────
POSTGRES_DB=hotel_concierge
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=hotel_pass
